{
  "name": "invoiceflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "vitest run --testTimeout 15000 --hookTimeout 30000",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify-pins": "node scripts/verify-pins.mjs",
    "check:claims": "node scripts/check-forbidden-claims.mjs",
    "check:release-gate": "node scripts/check-release-gate.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "bcrypt": "6.0.0",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "razorpay": "2.9.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "migrate-mongo": "14.0.7",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
