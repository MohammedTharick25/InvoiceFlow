{
  "name": "invoiceflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:parity": "vite build --config vite.parity.config.js",
    "preview": "vite preview --host 127.0.0.1",
    "build:marketing": "vite build ../marketing --config vite.marketing.config.js",
    "capture:marketing:screenshots": "node scripts/capture-marketing-screenshots.mjs",
    "test:e2e:marketing": "vite build ../marketing --config vite.marketing.config.js && playwright test --config playwright.marketing.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify-pins": "node scripts/verify-pins.mjs",
    "check:claims": "node scripts/check-forbidden-claims.mjs",
    "test:e2e": "vite build && vite build --config vite.parity.config.js && playwright test",
    "test:e2e:manual": "playwright test --config playwright.manual.config.js"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "6.0.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.64.0",
    "motion": "14.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
